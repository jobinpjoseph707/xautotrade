# The service reads these from its environment (it does not load this file). Key: `npm run key -- agent` in server/.
SERVER_URL=http://127.0.0.1:4000
AGENT_API_KEY=
# Where this service keeps its saved runs (its own file, never the trading database).
AGENTS_DB=agents.db
# Port for this service. Set the same address as AGENT_SERVICE_URL in the server's .env.
PORT=8000
