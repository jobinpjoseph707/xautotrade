# Copy to .env and fill in. With nothing set below, the server runs in
# PAPER MODE on simulated data — the whole app works, nothing touches a broker.

PORT=4000

# --- Broker selection ---------------------------------------------------------
# paper | metaapi | mt5mcp. Leave blank to auto-detect from which credentials
# below are filled in (metaapi wins if both are set).
BROKER=

# --- MetaApi (paid cloud MT5 bridge) ------------------------------------------
# Get a token at https://app.metaapi.cloud → API tokens.
# Then add your MT5 account there and copy its account id.
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=
# Deployment region of your MetaApi account: new-york | london | singapore
METAAPI_REGION=new-york

# --- MT5-via-MCP (free, self-hosted MT5 bridge) -------------------------------
# See README-mt5mcp.md. Requires MT5 desktop open and logged in on THIS machine.
# Set BROKER=mt5mcp above to use this.
#
# Default transport is stdio: this server launches the Python bridge itself,
# so there is NO second terminal window and no port to configure.
MT5MCP_TRANSPORT=stdio
MT5MCP_COMMAND=uvx
MT5MCP_ARGS=--from,mcp-metatrader5-server,mt5mcp
# Only used if MT5MCP_TRANSPORT=http (bridge running on another machine).
MT5MCP_URL=
# Leave these blank if MT5 desktop is already logged in — no need to store
# your broker password here too.
MT5MCP_LOGIN=
MT5MCP_PASSWORD=
MT5MCP_SERVER=
# ioc | fok | return — broker-dependent; try the others if orders get rejected.
MT5MCP_FILL_MODE=ioc
MT5MCP_DEVIATION_POINTS=20

# --- Safety ------------------------------------------------------------------
# The server REFUSES to place orders on a non-demo account unless this is true.
# Leave it false until you have forward-tested on demo for weeks.
ALLOW_LIVE_TRADING=false

# --- Access ------------------------------------------------------------------
# Shared secret the mobile app sends as x-api-key. Generated and persisted on
# first boot if you leave this blank.
API_KEY=

DB_PATH=./xautotrade.db
LOG_LEVEL=info
